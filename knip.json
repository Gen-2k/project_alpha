{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    "apps/server": {
      "entry": ["src/main.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/cli": {
      "entry": ["src/bin/giltflow.ts"],
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreDependencies": ["pino-pretty"],
  "ignoreBinaries": ["peers"]
}
