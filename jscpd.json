{
  "$schema": "https://github.com/kucherenko/jscpd",
  "threshold": 5,
  "minLines": 5,
  "minTokens": 50,
  "format": ["typescript"],
  "pattern": "{apps/server,packages/validation,packages/database}/src/**/*.ts",
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.turbo/**",
    "**/drizzle/**",
    "**/*.min.js"
  ]
}
