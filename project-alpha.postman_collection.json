    {
      "name": "05. Token Refresh & Rotation",
      "description": "Rotating refresh token lifecycle, replay detection, and grace periods.",
      "item": [
        {
          "name": "Refresh Token - Success Rotation (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Rotates and issues new token pair', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('accessToken');",
                  "    pm.expect(json).to.have.property('refreshToken');",
                  "    pm.expect(json.refreshToken).to.not.eql(pm.collectionVariables.get('refreshToken'));",
                  "    pm.collectionVariables.set('oldRotatedToken', pm.collectionVariables.get('refreshToken'));",
                  "    pm.collectionVariables.set('accessToken', json.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "refresh"]
            }
          }
        },
        {
          "name": "Refresh Token - Replay Rotated Token (401 Unauthorized)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401 Unauthorized', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "pm.test('Replay attack is blocked with TOKEN_REVOKED code', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.code).to.eql('TOKEN_REVOKED');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{oldRotatedToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
