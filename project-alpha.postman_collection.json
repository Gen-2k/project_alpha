    {
      "name": "02. Registration (Auth)",
      "description": "User account registration endpoints and validation edge cases.",
      "item": [
        {
          "name": "Register - Success (201 Created)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const uniqueEmail = `ada_${Date.now()}@example.com`;",
                  "pm.collectionVariables.set('dynamicEmail', uniqueEmail);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Tokens and user profile are returned', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('accessToken');",
                  "    pm.expect(json).to.have.property('refreshToken');",
                  "    pm.expect(json).to.have.property('user');",
                  "    pm.expect(json.user).to.have.property('id');",
                  "    pm.expect(json.user.email).to.eql(pm.collectionVariables.get('dynamicEmail'));",
                  "    pm.expect(json.user).to.not.have.property('passwordHash');",
                  "    pm.collectionVariables.set('accessToken', json.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "});",
                  "pm.test('HttpOnly refresh cookie is set', function () {",
                  "    pm.expect(pm.cookies.has('refreshToken')).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{dynamicEmail}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
