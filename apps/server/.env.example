NODE_ENV=development
LOG_LEVEL=info
PORT=3001
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/project_alpha
# Generate one (node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"),
# keep it out of Git: this file documents SHAPE, never real secrets.
JWT_SECRET=dev-only-secret-at-least-32-characters-long!!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
