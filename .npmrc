# pnpm strictness: every package declares exactly what it imports.
# - no hoisted "phantom" dependencies (catches missing deps at install time)
# - peers must resolve explicitly (catches React-duplication class of bugs)
# - workspace:* protocol is recorded as-is (pnpm 10+ default "rolling")
shamefully-hoist=false
strict-peer-dependencies=true
auto-install-peers=false
save-workspace-protocol=rolling
# Delay adopting brand-new registry releases (20160 min ≈ 14 days).
# New packages resolve to battle-tested versions; the lockfile stays reviewable.
minimumReleaseAge=20160
